@model RaceDay.MVC.Models.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-4" style="max-width: 750px;">
    <h1>Create an event</h1>

    <form asp-action="CreateEvent"
          method="post"
          enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label">Event name</label>
            <input asp-for="EventName" class="form-control" />
            <span asp-validation-for="EventName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventType" class="form-label">Event type</label>
            <select asp-for="EventType" class="form-select">
                <option value="Running">Running</option>
                <option value="Walking">Walking</option>
                <option value="Cycling">Cycling</option>
            </select>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="StartTime" class="form-label">Start time</label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Venue" class="form-label"></label>
            <input asp-for="Venue" class="form-control" />
            <span asp-validation-for="Venue" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Province" class="form-label"></label>
                <input asp-for="Province" class="form-control" />
                <span asp-validation-for="Province" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="DistanceKM" class="form-label">Distance (km)</label>
                <input asp-for="DistanceKM"
                       type="number"
                       step="0.1"
                       class="form-control" />
                <span asp-validation-for="DistanceKM" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="EntryFee" class="form-label">Entry fee</label>
                <input asp-for="EntryFee"
                       type="number"
                       step="0.01"
                       class="form-control" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="MaximumParticipants" class="form-label">
                    Participant limit
                </label>
                <input asp-for="MaximumParticipants"
                       type="number"
                       class="form-control" />
                <span asp-validation-for="MaximumParticipants"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="BannerImage" class="form-label">
                Event banner image
            </label>
            <input asp-for="BannerImage"
                   type="file"
                   accept=".jpg,.jpeg,.png,.webp"
                   class="form-control" />
        </div>

        <input asp-for="Status" type="hidden" />

        <button type="submit" class="btn btn-primary">Create event</button>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    var eventId = (int)ViewBag.EventId;
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Event enrolments</h1>
            <p class="text-muted mb-0">Event ID: @eventId</p>
        </div>

        <a asp-controller="Organizer"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to dashboard
        </a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <p>@Model.Count participant(s) enrolled.</p>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolled</th>
                        <th>Emergency contact</th>
                        <th>Payment</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>
                                @enrolment.ParticipantName
                                <div class="text-muted small">
                                    Enrolment #@enrolment.EnrolmentID
                                </div>
                            </td>
                            <td>@enrolment.CategoryName</td>
                            <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @enrolment.EmergencyContactName
                                <div class="text-muted small">
                                    @enrolment.EmergencyContactPhone
                                </div>
                            </td>
                            <td>@enrolment.PaymentStatus</td>
                            <td>@enrolment.EnrolmentStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
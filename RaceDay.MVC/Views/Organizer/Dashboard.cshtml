@model List<RaceDay.MVC.Models.EventViewModel>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Organiser Dashboard</h1>
            <p class="text-muted mb-0">Manage the events you have created.</p>
        </div>

        <a asp-controller="Organizer"
           asp-action="CreateEvent"
           class="btn btn-primary">
            Create event
        </a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            You do not have any events yet. Select <strong>Create event</strong>
            to add your first one.
        </div>
    }
    else
    {
        <p>You have created @Model.Count event(s).</p>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>@raceEvent.EventName</td>
                            <td>@raceEvent.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@raceEvent.Venue, @raceEvent.City</td>
                            <td>@raceEvent.DistanceKM km</td>
                            <td>@raceEvent.EventType</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Organizer"
                                       asp-action="EditEvent"
                                       asp-route-id="@raceEvent.EventID"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-controller="Organizer"
                                       asp-action="ManageCategories"
                                       asp-route-eventId="@raceEvent.EventID"
                                       class="btn btn-sm btn-outline-secondary">
                                        Categories
                                    </a>

                                    <a asp-controller="Organizer"
                                       asp-action="ManageEnrolments"
                                       asp-route-eventId="@raceEvent.EventID"
                                       class="btn btn-sm btn-outline-info">
                                        Enrolments
                                    </a>

                                    <a asp-controller="Organizer"
                                       asp-action="ManageResults"
                                       asp-route-eventId="@raceEvent.EventID"
                                       class="btn btn-sm btn-outline-success">
                                        Results
                                    </a>

                                    <form asp-controller="Organizer"
                                          asp-action="DeleteEvent"
                                          asp-route-id="@raceEvent.EventID"
                                          method="post"
                                          onsubmit="return confirm('Delete this event?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
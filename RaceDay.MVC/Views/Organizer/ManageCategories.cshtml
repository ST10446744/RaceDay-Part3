@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    var eventId = (int)ViewBag.EventId;
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Manage categories</h1>
            <p class="text-muted mb-0">Event ID: @eventId</p>
        </div>

        <a asp-controller="Organizer"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to dashboard
        </a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="card mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">Add a category</h2>
        </div>

        <div class="card-body">
            <form asp-controller="Organizer"
                  asp-action="CreateCategory"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" name="EventID" value="@eventId" />

                <div class="mb-3">
                    <label for="CategoryName" class="form-label">Category name</label>
                    <input id="CategoryName"
                           name="CategoryName"
                           class="form-control"
                           maxlength="100"
                           required />
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <textarea id="Description"
                              name="Description"
                              class="form-control"
                              rows="2"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="AgeMinimum" class="form-label">Minimum age</label>
                        <input id="AgeMinimum"
                               name="AgeMinimum"
                               type="number"
                               min="0"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label for="AgeMaximum" class="form-label">Maximum age</label>
                        <input id="AgeMaximum"
                               name="AgeMaximum"
                               type="number"
                               min="0"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label for="CategoryFee" class="form-label">Entry fee</label>
                        <input id="CategoryFee"
                               name="CategoryFee"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Add category</button>
            </form>
        </div>
    </section>

    <h2 class="h4 mb-3">Existing categories</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Age range</th>
                        <th>Entry fee</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.Description</td>
                            <td>@category.AgeMinimum–@category.AgeMaximum</td>
                            <td>@category.CategoryFee.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>